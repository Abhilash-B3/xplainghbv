// Prisma Schema for Xplain GH BV Investment Platform
// Phase 2: PostgreSQL Database & Financial Ledger Foundation

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ─── ENUMS ──────────────────────────────────────────────────────────

enum UserRole {
  INVESTOR
  ADMIN
  SUPPORT
  SUPERADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum Currency {
  EUR
  GBP
  GHS
}

enum PaymentMethod {
  MOMO
  VISA
}

enum ResalePlan {
  DIRECT
  SELLFOR
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum InvestmentStatus {
  INTENT_CREATED
  PAYMENT_PENDING
  ACTIVE
  FULFILLED
  MATURED
  CANCELLED
}

enum BatchStatus {
  ACTIVE
  MATURED
  DELIVERED
  CANCELLED
}

enum PayoutStatus {
  SCHEDULED
  PROCESSING
  PAID
  FAILED
}

enum WithdrawalType {
  RETURNS
  CAPITAL
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
  CANCELLED
}

enum DestinationType {
  MOMO
  BANK
}

enum PaymentProvider {
  STRIPE
  MTN_MOMO
  VODAFONE_CASH
  AIRTELTIGO_MONEY
  MANUAL_BANK
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYOUT
  REFUND
}

enum TransactionStatus {
  INITIALIZED
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
}

enum ReferralStatus {
  REGISTERED
  ACTIVE
  INACTIVE
}

enum CommissionStatus {
  CALCULATED
  PENDING_PAYOUT
  PAID
  CANCELLED
}

enum AccountType {
  AVAILABLE_RETURNS
  LOCKED_CAPITAL
  UNLOCKED_CAPITAL
  WITHDRAWAL_RESERVED
  PLATFORM_ESCROW
  PLATFORM_REVENUE
  REFERRAL_BONUS_PAYABLE
}

enum NotificationType {
  SYSTEM
  SECURITY
  INVESTMENT
  PAYOUT
  WITHDRAWAL
  REFERRAL
  ADMIN
}

enum EntryType {
  DEBIT
  CREDIT
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ─── USER & IDENTITY MODELS ─────────────────────────────────────────

model User {
  id               String        @id @default(uuid()) @db.Uuid
  email            String        @unique @db.VarChar(255)
  phone            String        @unique @db.VarChar(32)
  passwordHash     String        @db.VarChar(255)
  role             UserRole      @default(INVESTOR)
  status           AccountStatus @default(ACTIVE)
  isEmailVerified  Boolean       @default(false)
  isPhoneVerified  Boolean       @default(false)
  twoFactorEnabled Boolean       @default(false)
  twoFactorSecret  String?       @db.VarChar(255)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)

  // Relationships
  partnerProfile          PartnerProfile?
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  termsAcceptances        UserTermsAcceptance[]
  auditLogs               AuditLog[]
  approvedWithdrawals     Withdrawal[]          @relation("ApprovedWithdrawals")
  notifications           Notification[]
  notificationPreference  NotificationPreference?

  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("users")
}

model PartnerProfile {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @unique @db.Uuid
  fullName             String        @db.VarChar(128)
  preferredCurrency    Currency      @default(EUR)
  defaultPaymentMethod PaymentMethod @default(MOMO)
  resalePlan           ResalePlan?
  referralCode         String        @unique @db.VarChar(16)
  kycStatus            KYCStatus     @default(NOT_SUBMITTED)
  createdAt            DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(6)

  // Relationships
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  addresses           Address[]
  investments         Investment[]
  investmentBatches   InvestmentBatch[]
  payouts             Payout[]
  withdrawals         Withdrawal[]
  bankAccounts        BankAccount[]
  moMoAccounts        MoMoAccount[]
  financialAccounts   FinancialAccount[]
  paymentTransactions PaymentTransaction[]

  // Referral relationships
  referredBy           Referral?            @relation("RefereeProfile")
  referees             Referral[]           @relation("ReferrerProfile")
  commissionsEarned    ReferralCommission[] @relation("ReferrerCommissions")
  commissionsGenerated ReferralCommission[] @relation("RefereeCommissions")

  @@index([referralCode])
  @@index([preferredCurrency])
  @@map("partner_profiles")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  ipAddress String?   @db.VarChar(45)
  userAgent String?   @db.VarChar(255)
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Address {
  id               String   @id @default(uuid()) @db.Uuid
  partnerProfileId String   @db.Uuid
  fullName         String   @db.VarChar(128)
  line1            String   @db.VarChar(255)
  line2            String?  @db.VarChar(255)
  city             String   @db.VarChar(128)
  postcode         String   @db.VarChar(32)
  country          String   @db.VarChar(128)
  phone            String?  @db.VarChar(32)
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  // Relationships
  partnerProfile PartnerProfile @relation(fields: [partnerProfileId], references: [id], onDelete: Cascade)
  investments    Investment[]

  @@index([partnerProfileId])
  @@map("addresses")
}

// ─── PRODUCT & CATALOGUE MODELS ─────────────────────────────────────

model ProductCategory {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(64)
  slug         String   @unique @db.VarChar(64)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  // Relationships
  products Product[]

  @@index([slug])
  @@index([isActive])
  @@map("product_categories")
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  categoryId    String   @db.Uuid
  ref           String   @unique @db.VarChar(32)
  name          String   @db.VarChar(255)
  description   String?  @db.Text
  priceEUR      Decimal  @db.Decimal(12, 2)
  imageUrl      String   @db.VarChar(512)
  stockQuantity Int      @default(100)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  // Relationships
  category        ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  investmentItems InvestmentItem[]

  @@index([ref])
  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model ShowcaseAppliance {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(128)
  desc         String   @db.VarChar(255)
  imageUrl     String   @db.VarChar(512)
  tag          String   @db.VarChar(32)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@index([isActive, displayOrder])
  @@map("showcase_appliances")
}

// ─── INVESTMENT & BATCH MODELS ──────────────────────────────────────

model Investment {
  id                       String           @id @default(uuid()) @db.Uuid
  partnerProfileId         String           @db.Uuid
  resalePlan               ResalePlan
  status                   InvestmentStatus @default(INTENT_CREATED)
  currency                 Currency
  subtotalInCurrency       Decimal          @db.Decimal(14, 2)
  discountAmountInCurrency Decimal          @default(0) @db.Decimal(14, 2)
  totalAmountInCurrency    Decimal          @db.Decimal(14, 2)
  totalAmountEUR           Decimal          @db.Decimal(14, 2)
  exchangeRateToEUR        Decimal          @db.Decimal(18, 8)
  deliveryAddressId        String?          @db.Uuid
  idempotencyKey           String?          @unique @db.VarChar(64)
  createdAt                DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime         @updatedAt @db.Timestamptz(6)

  // Relationships
  partnerProfile      PartnerProfile       @relation(fields: [partnerProfileId], references: [id], onDelete: Restrict)
  deliveryAddress     Address?             @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  items               InvestmentItem[]
  batch               InvestmentBatch?
  paymentTransactions PaymentTransaction[]

  @@index([partnerProfileId])
  @@index([status])
  @@index([createdAt])
  @@map("investments")
}

model InvestmentItem {
  id                 String   @id @default(uuid()) @db.Uuid
  investmentId       String   @db.Uuid
  productId          String   @db.Uuid
  productRef         String   @db.VarChar(32)
  productName        String   @db.VarChar(255)
  unitPriceEUR       Decimal  @db.Decimal(12, 2)
  discountMultiplier Decimal  @default(1.00) @db.Decimal(4, 2)
  quantity           Int      @default(1)
  lineTotalEUR       Decimal  @db.Decimal(14, 2)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  // Relationships
  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([investmentId])
  @@index([productId])
  @@map("investment_items")
}

model InvestmentBatch {
  id                 String      @id @default(uuid()) @db.Uuid
  investmentId       String      @unique @db.Uuid
  partnerProfileId   String      @db.Uuid
  batchNumber        Int         @default(1)
  capitalEUR         Decimal     @db.Decimal(14, 2)
  monthlyReturnRate  Decimal     @default(0.0700) @db.Decimal(5, 4)
  discountMultiplier Decimal     @default(0.86) @db.Decimal(4, 2)
  lockDurationMonths Int         @default(12)
  startDate          DateTime    @db.Date
  firstPayoutDate    DateTime    @db.Date
  capitalUnlockDate  DateTime    @db.Date
  status             BatchStatus @default(ACTIVE)
  createdAt          DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(6)

  // Relationships
  investment     Investment     @relation(fields: [investmentId], references: [id], onDelete: Restrict)
  partnerProfile PartnerProfile @relation(fields: [partnerProfileId], references: [id], onDelete: Restrict)
  payouts        Payout[]

  @@index([partnerProfileId])
  @@index([status])
  @@index([capitalUnlockDate])
  @@map("investment_batches")
}

model Payout {
  id                   String       @id @default(uuid()) @db.Uuid
  batchId              String       @db.Uuid
  partnerProfileId     String       @db.Uuid
  payoutIndex          Int
  dueDate              DateTime     @db.Date
  amountEUR            Decimal      @db.Decimal(14, 2)
  status               PayoutStatus @default(SCHEDULED)
  paidAt               DateTime?    @db.Timestamptz(6)
  paymentTransactionId String?      @db.Uuid
  createdAt            DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(6)

  // Relationships
  batch              InvestmentBatch     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  partnerProfile     PartnerProfile      @relation(fields: [partnerProfileId], references: [id], onDelete: Restrict)
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@unique([batchId, payoutIndex])
  @@index([partnerProfileId])
  @@index([dueDate, status])
  @@map("payouts")
}

// ─── PAYMENT & TRANSACTIONS ─────────────────────────────────────────

model PaymentTransaction {
  id                    String            @id @default(uuid()) @db.Uuid
  referenceNumber       String            @unique @db.VarChar(64)
  investmentId          String?           @db.Uuid
  partnerProfileId      String            @db.Uuid
  provider              PaymentProvider
  providerTransactionId String?           @unique @db.VarChar(128)
  stripePaymentIntentId String?           @unique @db.VarChar(128)
  stripeCustomerId      String?           @db.VarChar(128)
  stripePaymentStatus   String?           @db.VarChar(64)
  stripeLatestEventId   String?           @db.VarChar(128)
  type                  TransactionType
  amount                Decimal           @db.Decimal(14, 2)
  currency              Currency
  canonicalAmountEUR    Decimal           @db.Decimal(14, 2)
  status                TransactionStatus @default(INITIALIZED)
  paidAt                DateTime?         @db.Timestamptz(6)
  failureCode           String?           @db.VarChar(64)
  failureMessage        String?           @db.Text
  idempotencyKey        String?           @unique @db.VarChar(64)
  providerMetadata      Json?
  createdAt             DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(6)

  // Relationships
  investment     Investment?          @relation(fields: [investmentId], references: [id], onDelete: SetNull)
  partnerProfile PartnerProfile       @relation(fields: [partnerProfileId], references: [id], onDelete: Restrict)
  payouts        Payout[]
  commissions    ReferralCommission[]

  @@index([partnerProfileId])
  @@index([referenceNumber])
  @@index([stripePaymentIntentId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_transactions")
}

model StripePaymentEvent {
  id              String   @id @default(uuid()) @db.Uuid
  eventId         String   @unique @db.VarChar(128)
  eventType       String   @db.VarChar(64)
  paymentIntentId String?  @db.VarChar(128)
  status          String   @default("PROCESSED") @db.VarChar(32)
  errorMessage    String?  @db.Text
  processedAt     DateTime @default(now()) @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([eventId])
  @@index([eventType])
  @@index([paymentIntentId])
  @@map("stripe_payment_events")
}

// ─── WITHDRAWALS & ACCOUNTS ─────────────────────────────────────────

model Withdrawal {
  id                   String           @id @default(uuid()) @db.Uuid
  partnerProfileId     String           @db.Uuid
  withdrawalType       WithdrawalType
  amount               Decimal          @db.Decimal(14, 2)
  currency             Currency
  amountEUR            Decimal          @db.Decimal(14, 2)
  destinationType      DestinationType
  bankAccountId        String?          @db.Uuid
  moMoAccountId        String?          @db.Uuid
  status               WithdrawalStatus @default(PENDING)
  rejectionReason      String?          @db.Text
  approvedByUserId     String?          @db.Uuid
  settlementReference  String?          @db.VarChar(128)
  settlementProof      Json?
  failureCode          String?          @db.VarChar(64)
  processedAt          DateTime?        @db.Timestamptz(6)
  idempotencyKey       String?          @unique @db.VarChar(64)
  createdAt            DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(6)

  // Relationships
  partnerProfile PartnerProfile @relation(fields: [partnerProfileId], references: [id], onDelete: Restrict)
  bankAccount    BankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  moMoAccount    MoMoAccount?   @relation(fields: [moMoAccountId], references: [id], onDelete: SetNull)
  approvedByUser User?          @relation("ApprovedWithdrawals", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([partnerProfileId])
  @@index([status])
  @@index([createdAt])
  @@map("withdrawals")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType @default(SYSTEM)
  title     String           @db.VarChar(128)
  message   String           @db.Text
  eventKey  String?          @unique @db.VarChar(128) // Durable idempotency key
  readAt    DateTime?        @db.Timestamptz(6)
  metadata  Json?
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  emailInvestments Boolean  @default(true)
  emailPayouts     Boolean  @default(true)
  emailWithdrawals Boolean  @default(true)
  emailReferrals   Boolean  @default(true)
  emailMarketing   Boolean  @default(false)
  inAppSecurity    Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model BankAccount {
  id                     String   @id @default(uuid()) @db.Uuid
  partnerProfileId       String   @db.Uuid
  bankName               String   @db.VarChar(128)
  accountNumberMasked    String   @db.VarChar(32)
  accountNumberEncrypted String   @db.Text
  sortCodeOrSwift        String   @db.VarChar(32)
  accountHolderName      String   @db.VarChar(128)
  currency               Currency @default(EUR)
  country                String   @db.VarChar(64)
  isVerified             Boolean  @default(false)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)

  // Relationships
  partnerProfile PartnerProfile @relation(fields: [partnerProfileId], references: [id], onDelete: Cascade)
  withdrawals    Withdrawal[]

  @@index([partnerProfileId])
  @@map("bank_accounts")
}

model MoMoAccount {
  id                   String          @id @default(uuid()) @db.Uuid
  partnerProfileId     String          @db.Uuid
  provider             PaymentProvider @default(MTN_MOMO)
  phoneNumberMasked    String          @db.VarChar(32)
  phoneNumberEncrypted String          @db.Text
  accountHolderName    String          @db.VarChar(128)
  country              String          @default("GH") @db.VarChar(64)
  isVerified           Boolean         @default(false)
  createdAt            DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(6)

  // Relationships
  partnerProfile PartnerProfile @relation(fields: [partnerProfileId], references: [id], onDelete: Cascade)
  withdrawals    Withdrawal[]

  @@index([partnerProfileId])
  @@map("momo_accounts")
}

// ─── REFERRAL SYSTEM ────────────────────────────────────────────────

model Referral {
  id                String         @id @default(uuid()) @db.Uuid
  referrerProfileId String         @db.Uuid
  refereeProfileId  String         @unique @db.Uuid
  status            ReferralStatus @default(REGISTERED)
  attributionDate   DateTime       @default(now()) @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(6)

  // Relationships
  referrer    PartnerProfile       @relation("ReferrerProfile", fields: [referrerProfileId], references: [id], onDelete: Restrict)
  referee     PartnerProfile       @relation("RefereeProfile", fields: [refereeProfileId], references: [id], onDelete: Restrict)
  commissions ReferralCommission[]

  @@index([referrerProfileId])
  @@index([refereeProfileId])
  @@index([status])
  @@map("referrals")
}

model ReferralCommission {
  id                   String           @id @default(uuid()) @db.Uuid
  referralId           String           @db.Uuid
  referrerProfileId    String           @db.Uuid
  refereeProfileId     String           @db.Uuid
  periodMonth          String           @db.VarChar(7) // Format: "YYYY-MM"
  refereeCapitalEUR    Decimal          @db.Decimal(14, 2)
  commissionRate       Decimal          @default(0.0300) @db.Decimal(5, 4)
  commissionAmountEUR  Decimal          @db.Decimal(14, 2)
  status               CommissionStatus @default(CALCULATED)
  paidAt               DateTime?        @db.Timestamptz(6)
  paymentTransactionId String?          @db.Uuid
  createdAt            DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(6)

  // Relationships
  referral           Referral            @relation(fields: [referralId], references: [id], onDelete: Restrict)
  referrer           PartnerProfile      @relation("ReferrerCommissions", fields: [referrerProfileId], references: [id], onDelete: Restrict)
  referee            PartnerProfile      @relation("RefereeCommissions", fields: [refereeProfileId], references: [id], onDelete: Restrict)
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@unique([referralId, periodMonth])
  @@index([referrerProfileId])
  @@index([status])
  @@map("referral_commissions")
}

// ─── FINANCIAL DOUBLE-ENTRY LEDGER ──────────────────────────────────

model FinancialAccount {
  id               String      @id @default(uuid()) @db.Uuid
  partnerProfileId String?     @db.Uuid
  accountType      AccountType
  currency         Currency    @default(EUR)
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(6)

  // Relationships
  partnerProfile PartnerProfile? @relation(fields: [partnerProfileId], references: [id], onDelete: Cascade)
  ledgerEntries  LedgerEntry[]

  @@unique([partnerProfileId, accountType])
  @@index([partnerProfileId])
  @@index([accountType])
  @@map("financial_accounts")
}

model LedgerTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  referenceNumber String   @unique @db.VarChar(64)
  description     String   @db.VarChar(255)
  sourceEntity    String   @db.VarChar(64)
  sourceEntityId  String   @db.VarChar(64)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  // Relationships
  entries LedgerEntry[]

  @@index([sourceEntity, sourceEntityId])
  @@index([referenceNumber])
  @@index([createdAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String    @id @default(uuid()) @db.Uuid
  transactionId String    @db.Uuid
  accountId     String    @db.Uuid
  entryType     EntryType
  amount        Decimal   @db.Decimal(14, 4)
  currency      Currency
  amountEUR     Decimal   @db.Decimal(14, 4)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  // Relationships
  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     FinancialAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId])
  @@index([createdAt])
  @@map("ledger_entries")
}

// ─── EXCHANGE RATES, LEGAL & AUDIT ──────────────────────────────────

model ExchangeRateSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  baseCurrency  Currency @default(EUR)
  quoteCurrency Currency
  rate          Decimal  @db.Decimal(18, 8)
  source        String   @default("PLATFORM_TREASURY") @db.VarChar(64)
  effectiveAt   DateTime @default(now()) @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([baseCurrency, quoteCurrency, effectiveAt])
  @@map("exchange_rate_snapshots")
}

model LegalDocument {
  id        String         @id @default(uuid()) @db.Uuid
  slug      String         @unique @db.VarChar(64)
  title     String         @db.VarChar(128)
  status    DocumentStatus @default(PUBLISHED)
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)

  // Relationships
  versions LegalVersion[]

  @@index([slug])
  @@map("legal_documents")
}

model LegalVersion {
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String   @db.Uuid
  versionNumber Int      @default(1)
  content       Json
  effectiveDate DateTime @default(now()) @db.Date
  isCurrent     Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  // Relationships
  document    LegalDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  acceptances UserTermsAcceptance[]

  @@unique([documentId, versionNumber])
  @@index([documentId, isCurrent])
  @@map("legal_versions")
}

model UserTermsAcceptance {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  legalVersionId String   @db.Uuid
  ipAddress      String?  @db.VarChar(45)
  userAgent      String?  @db.VarChar(255)
  acceptedAt     DateTime @default(now()) @db.Timestamptz(6)

  // Relationships
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalVersion LegalVersion @relation(fields: [legalVersionId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([legalVersionId])
  @@map("user_terms_acceptances")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  action        String   @db.VarChar(64)
  entityType    String   @db.VarChar(64)
  entityId      String   @db.VarChar(64)
  previousState Json?
  newState      Json?
  ipAddress     String?  @db.VarChar(45)
  userAgent     String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  // Relationships
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
